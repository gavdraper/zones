# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Build artifacts / assembled app bundle
build/
DerivedData/
*.app

# Release DMG archive consumed by Scripts/appcast.sh (binaries live in GitHub Releases)
dist/
*.dmg

# Xcode (in case anyone opens the package in Xcode)
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Signing / secrets — never commit local certs or keys
*.p12
*.pem
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile

# Demo recordings — keep docs/demo.gif, not the raw screen captures
*.mov
*.mp4

# Editor / tooling
.idea/
*.swp
.vscode/
